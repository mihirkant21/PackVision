# =====================================================================
# PackVision AI - Local Environment Configuration
# =====================================================================
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Database & Local Storage (Strictly Local)
DATABASE_URL=sqlite:///./packvision.db
STORAGE_PATH=./storage
MAX_UPLOAD_MB=25

# =====================================================================
# Inference Strategy (Local GPU / Colab GPU / Procedural Fallback)
# =====================================================================
# Set USE_MOCK_INFERENCE=false to execute local SD 1.5 + ControlNet Canny on GPU
USE_MOCK_INFERENCE=true
MODEL_DEVICE=auto
RENDER_ENGINE=local

# Stable Diffusion 1.5 + ControlNet Canny (Lightweight 512x512 config for 4GB GTX 1650 Ti)
SD15_BASE_MODEL=runwayml/stable-diffusion-v1-5
CONTROLNET_CANNY_MODEL=lllyasviel/control_v11p_sd15_canny

# Optional: Google Colab Remote GPU Bridge URL (Leave blank if running 100% locally)
# Run colab/PackVision_Colab_GPU.ipynb and paste public ngrok/localtunnel URL here:
COLAB_INFERENCE_URL=

# Rate Limits (Local safeguards)
RATE_LIMIT_UPLOADS_PER_MIN=60
RATE_LIMIT_GENERATIONS_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=240
