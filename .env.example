# PackVision AI Environment Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Database & Storage
DATABASE_URL=sqlite:///./packvision.db
STORAGE_PATH=./storage
MAX_UPLOAD_MB=25

# Model Inference Configuration
# Set USE_MOCK_INFERENCE=false to use full Stable Diffusion XL + ControlNet weights
USE_MOCK_INFERENCE=true
MODEL_DEVICE=auto
SDXL_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
CONTROLNET_MODEL=diffusers/controlnet-canny-sdxl-1.0
VAE_MODEL=madebyollin/sdxl-vae-fp16-fix
LORA_WEIGHTS_PATH=

# AI Provider API Keys (NEVER commit real keys)
STABILITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Free photoreal tier #2: Cloudflare Workers AI img2img (tried after HuggingFace)
# Free tier: 10,000 Neurons/day (~20-30 images), NO credit card required.
# 1. Create a free account: https://dash.cloudflare.com/sign-up
# 2. Account ID: dash.cloudflare.com -> any account Overview -> right sidebar "Account ID"
# 3. API Token: dash.cloudflare.com -> avatar (My Profile) -> API Tokens ->
#    Create Token -> "Workers AI" template (or custom token with
#    Account / Workers AI / "Run" permission)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional overrides (defaults shown; SD1.5 img2img quality < FLUX.1-Kontext)
CLOUDFLARE_IMG2IMG_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img
CLOUDFLARE_STRENGTH=0.55

# Free photoreal tier #3 (DORMANT SKELETON): ModelScope API-Inference Qwen-Image-Edit
# Token: https://modelscope.cn -> sign in (GitHub or phone) -> account icon ->
#        "Access Tokens" (https://modelscope.cn/my/mytoken) - free, no card.
# NOTE: the REST image-edit endpoint takes a publicly HOSTED image_url (inline
# base64 is not supported/verified), so this provider is disabled by default
# and raises a clear error instead of firing a doomed request.
MODELSCOPE_API_TOKEN=
MODELSCOPE_ENABLED=false
MODELSCOPE_IMAGE_MODEL=Qwen/Qwen-Image-Edit

# Hybrid Engine Configuration
# RENDER_ENGINE: cloud | local | auto  (auto = cloud if keys present, else local PBR fallback)
RENDER_ENGINE=auto
CLOUD_IMAGE_PROVIDER=auto
VLM_PROVIDER=auto
# Stability AI sketch->photoreal control (tried when STABILITY_API_KEY is set)
STABILITY_IMAGE_MODEL=sketch
STABILITY_CONTROL_STRENGTH=0.7
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_VLM_MODEL=gemini-3.8-flash

# Free photoreal tier: HuggingFace ZeroGPU Flux Kontext (no key needed)
# Sketches are uploaded to HuggingFace's public inference service for rendering.
HF_ENABLED=true
HF_SPACE=black-forest-labs/FLUX.1-Kontext-dev
# Optional HF token raises the anonymous ZeroGPU quota (https://huggingface.co/settings/tokens)
HF_TOKEN=
